/*
 * Lab C4 (Camera JPEG Encode + TFT Still Preview) - SR110 (sr100_rdk/sr100/m55)
 *
 * This overlay combines two independent pieces:
 *
 * 1) JPEG hardware encoder pipeline (unchanged from the SDK's
 *    samples/drivers/video/enc sample) - the sensor's CSI output is
 *    connected directly to the encoder node (lp_jpeg0), bypassing
 *    video_syna0 entirely. See the lab doc for why.
 *
 * 2) ST7789V3 TFT over SPI0, reusing Lab C3's confirmed-working
 *    config verbatim, to show the just-encoded JPEG as a still image
 *    after it is decoded back to RGB565 on-device. SPI0's MOSI/MISO
 *    pads are physically shared with the M55's default console UART
 *    (UART1, GPIO23/24), so the console is moved to UART0's alternate
 *    pin group here, exactly like Lab C3 - an external USB-TTL
 *    adapter is needed to see console output (GPIO44/45, J24 pins
 *    13/14).
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/memory-attr/memory-attr-arm.h>

/ {
	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		jpeg_encoder_mem: jpeg-encoder-memory@b4900000 {
			compatible = "zephyr,memory-region", "mmio-sram";
			reg = <0xB4900000 0x9D800>; /* 0x4000 + 0x7e900 (960x540 RAW8) + 0x1af00 (max JPEG) */
			zephyr,memory-region = "JPEG_ENCODER_MEM";
			zephyr,memory-attr = <DT_MEM_ARM_MPU_RAM_NOCACHE>;
		};
	};

	lp_jpeg0: lp-enc-video {
		compatible = "syna,enc-video";
		status = "okay";
		interrupt-parent = <&nvic>;
		/*
		 * This JPEG encoder flow uses all three underlying IRQ lines:
		 * 102 = FRAME_PROCESSING_DONE, 103 = FMIN1_FRAME_STORED,
		 * 109 = c0 / status events.
		 */
		interrupts = <102 0>, <103 0>, <109 0>;
		interrupt-names = "frame-done", "fmin1-stored", "status";

		/*
		 * Build-time selectable mode.
		 *
		 * Define ENC_MEMORY_INPUT via DTS_EXTRA_CPPFLAGS to switch the
		 * encoder to reserved-memory input mode (static raw in memory).
		 * See "추가로 알면 좋은 내용" in the lab doc for how to try this.
		 */
#ifdef ENC_MEMORY_INPUT
		mode = <1>; /* memory-input mode */
#else
		mode = <0>; /* live sensor mode - default for this lab */
#endif

		/* JPEG encoder reserved memory for raw input and JPEG output buffers. */
		memory-region = <&jpeg_encoder_mem>;
		/* Reserve programmer area (SRSDK default is 0x4000). */
		frame-raw-offset = <0x4000>;

#ifdef ENC_MEMORY_INPUT
		/* Raw input (960x540 = 0x7E900 bytes) starts at frame-raw-offset. */
		max-jpeg-size = <0x1af00>;
#else
		max-jpeg-size = <0x20000>;
#endif

		port {
			lp_jpeg0_in: endpoint {
				remote-endpoint-label = "ov02c10_out";
				bus-type = <4>;
				clock-lane = <0>;
				data-lanes = <1>;
			};
		};

	};
};

	&i2c1 {
		ov02c10: ov02c10@36 {
			compatible = "ovti,ov02c10";
			reg = <0x36>;
#ifdef ENC_MEMORY_INPUT
			status = "disabled";
#else
			status = "okay";
#endif

		pinctrl-0 = <&clkout_0>;
		pinctrl-names = "default";

		powerdown-gpios = <&gpio_exp0 8 GPIO_ACTIVE_HIGH>;
		shutdown-gpios = <&gpio_exp0 13 GPIO_ACTIVE_HIGH>;

		mclk-control-reg = <0x50330044>;
		mclk-control-val = <0x0000000b>;

		port {
			ov02c10_out: endpoint {
				bus-type = <4>;
				clock-lane = <0>;
				data-lanes = <1>;
				remote-endpoint-label = "lp_jpeg0_in";
			};
		};
	};
};

/* --- TFT still-preview display (Lab C3 config, reused verbatim) --- */

&spi0 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	pinctrl-0 = <&spi_mstr_mosi &spi_mstr_miso &spi_mstr_clk &spi_mstr_cs>;
	pinctrl-names = "default";

	st7789v_disp: st7789v@0 {
		compatible = "zds,st7789v";
		reg = <0>;
		spi-max-frequency = <4000000>;
		reset-gpios = <&gpioa 17 GPIO_ACTIVE_LOW>;  /* SoC GPIO17, J24 pin 3 - through level shifter */
		dc-gpios = <&gpioa 18 GPIO_ACTIVE_HIGH>;    /* SoC GPIO18, J24 pin 4 - through level shifter */
		width = <240>;
		height = <280>;
		x-offset = <0>;
		y-offset = <20>;
	};
};

&ns16550_uart1 {
	status = "disabled";
};

&ns16550_uart0 {
	pinctrl-0 = <&uart0_tx_c &uart0_rx_c>;
	pinctrl-names = "default";
	current-speed = <230400>;
	dlf = <2>;
	status = "okay";
};

/ {
	chosen {
		zephyr,console = &ns16550_uart0;
		zephyr,shell-uart = &ns16550_uart0;
	};
};
